---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, withBase } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const poster = project.data.demoMedia.poster || project.data.cover;
const tutorial = project.data.tutorialResources;
const isCrossBorderExport = project.id === 'cross-border-export';
const isEmploymentWorkflow = project.id === 'employment-legal-workflow';
const isEmploymentApplication = project.id === 'time-calculator' || project.id === 'evidence-organizer';
const isRiskScreening = project.id === 'risk-screening';
const employmentSteps = [
  ['ISSUE', '先判断真正的问题是什么', '先定位劳动关系阶段：招聘入职、合同与试用期、工时薪酬、绩效与岗位调整、违纪调查、解除终止、离职义务或劳动争议。先定义问题，再决定需要查什么。'],
  ['FACTS & DOCUMENTS', '确认事实和现有材料', '核对劳动合同、员工手册、考勤与工资、绩效、邮件沟通、培训、处分、签收等记录。劳动问题既要判断发生了什么，也要判断公司能够证明什么。'],
  ['RULES', '建立法律路径', '根据具体事实查询法律、行政法规、司法解释、地方规则、相关案例和公司内部制度，先形成可能路径，再核对具体规则。'],
  ['PROCEDURE', '实体判断和程序一起检查', '除实体权利外，继续检查通知、培训或调岗、内部审批、制度建立与公示，以及时间节点等程序风险。'],
  ['EVIDENCE', '把举证问题前置', '在采取管理措施时就确认谁掌握证据、需要保存什么、是否形成书面记录、员工是否确认签收，以及材料能否组成完整时间线。'],
  ['OPTIONS & BUSINESS IMPACT', '不只给一个法律答案', '比较继续管理、培训或调岗、协商、依法解除等路径，同时衡量法律与举证风险、时间和经济成本、员工关系影响及执行难度。'],
  ['STAKEHOLDERS', 'HR、业务和 Legal 协同', '不自行假设管理事实；与 HR、直属业务负责人、财务及必要职能确认实际情况、业务目标和执行条件。'],
  ['RECOMMENDATION & DOCUMENTATION', '形成建议并留下记录', '综合依据、事实、程序、证据、公司制度、目标、成本与风险形成可执行建议，并沉淀处理记录、关键文件、时间线、决策依据、模板、SOP 和后续事项。']
];
const processSteps = [
  ['海外询盘', '直接与海外客户确认商务问题、产品需求和后续履约信息。'],
  ['合同与保密', '推进 NNN、销售合同、争议解决及中英文表述的修订确认。'],
  ['收款与生产', '配合财务与技术人员确认收款节点、生产参数和履约安排。'],
  ['出口与物流', '处理申报字段、报关材料、系统问题和交付节点。'],
  ['流程沉淀', '把首次执行中遇到的问题整理为检查清单和可复用 SOP。'],
  ['海外业务入口', '将产品、制造能力与海外联系方式整理为可长期使用的英文官网。']
];
const coreWork = [
  ['英文客户沟通', '直接与海外客户确认商务和合同事项'],
  ['双语合同修订', '处理销售合同、付款安排及中英文表述一致性'],
  ['NNN 协议谈判', '参与适用法律、仲裁机构、仲裁地、语言和保密信息定义的沟通'],
  ['出口申报', '实际进入国际贸易单一窗口，处理申报字段、资料准备和系统问题'],
  ['跨部门协调', '与财务、技术人员及外部专业人士协作'],
  ['SOP 沉淀', '将一次性问题整理为检查清单和可复用流程']
];
const keyCases = [
  {
    label: '案例 A',
    title: '跨境争议解决条款',
    problem: '双方需要就适用法律、仲裁机构、仲裁地和仲裁语言达成平衡。',
    action: '梳理双方诉求，提出以中国法为适用法律、CIETAC Hong Kong Arbitration Center 为仲裁机构、香港为仲裁地、英语为仲裁语言的折中方案，并通过英文邮件推进确认。'
  },
  {
    label: '案例 C',
    title: '首次出口申报',
    problem: '首次接触国际贸易单一窗口，涉及企业信息、运输、包装、商品、监管和申报字段，且存在浏览器、证书和系统配置问题。',
    action: '拆分字段，查询官方说明，向专业人士确认不确定项，逐项验证，并记录操作步骤以便复用。'
  }
];
const confidentialitySteps = [
  ['客户提出问题', '客户明确提出，只有标记为“Confidential”的信息才应受保护。这个异议起初并不是我特别关注的问题；过去参与的国内业务合同，也较少把识别标准细化到这一层。'],
  ['识别实际风险', '客户反复强调后，我开始追问这一标准在实际信息流转中的后果：技术参数、图纸、报价、测试数据、产品设计和项目信息，可能因邮件、会议或即时通讯中的一次漏标而失去合同保护。'],
  ['调用既有法律训练', '客户异议触发了 issue spotting。我联想到保护范围不应只依赖形式标签，以及可结合客观情境判断一方是否“应当知道”。这先形成了一个待验证的初步判断，而不是直接套用某一条法律规定。'],
  ['查证与专业校准', '我检索类似 confidentiality drafting、核对常见定义方式并寻找遗漏；同时向技术人员确认会披露什么信息、如何流转，以及是否能现实地保证每次披露都单独标记。合同标准需要适应真实的信息流转方式。'],
  ['形成可执行标准', '最终签署版本没有采用“未标记即不保护”的绝对标准，而是结合信息内容、性质和披露情境判断；同时通过 exclusions 排除已公开、事先合法掌握、从无保密义务第三方合法取得、独立开发及依法必须披露的信息。']
];
const evidenceItems = [
  ['nnn-agreement-redacted.png', '已脱敏的双语 NNN 协议截图', '双语 NNN 协议：参与保密、禁止使用、禁止绕行条款修订'],
  ['negotiation-email-redacted.png', '已脱敏的英文谈判邮件截图', '英文谈判邮件：就争议解决和保密范围提出修订方案'],
  ['sales-contract-redacted.png', '已脱敏的双语销售合同截图', '双语销售合同：处理交易主体、产品、付款与履约条款'],
  ['china-single-window-redacted.png', '已脱敏的中国国际贸易单一窗口截图', '出口申报系统：实际参与出口报关信息录入']
];
const methodSteps = [
  ['SPOT', '快速识别问题', '依靠已有经验和法律训练捕捉异常点、权利义务不对称、潜在风险及可能路径。第一反应不是结论，而是一个需要继续验证的 highlight。'],
  ['STRUCTURE', '把问题结构化', '把模糊的“不对劲”转化为具体问题：谁承担什么义务，风险如何分配，哪些事实和规则需要确认，以及业务最终需要什么判断。'],
  ['VERIFY & EXPAND', '校准并寻找盲点', '使用法规与案例检索、法律数据库、Legal AI、通用 AI、开源工具和专业软件，验证第一判断的依据，并主动寻找反例、例外、遗漏风险和可复用方案。'],
  ['CONSULT', '让专业事实回到专业人员', '涉及技术、财务、生产、物流、销售或 IT 时，不在纯法律层面推测；向对应人员确认真实流程、操作限制、商业目标与执行成本。'],
  ['JUDGE & DOCUMENT', '形成判断并留下记录', '综合法律依据、工具结果、专业意见、业务目标、风险与成本形成建议，并保留最终文件、修改记录、争议点、决策依据、模板、SOP 和交接信息。']
];
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  {isCrossBorderExport ? (
    <article class="case-page">
      <header class="detail-hero case-hero shell">
        <a class="back-link" href={withBase('projects/')}>← 返回项目列表</a>
        <div class="detail-title-grid">
          <div>
            <div class="detail-kicker-row">
              <p class="kicker">{project.data.eyebrow}</p>
              <span class="status-group">
                {project.data.statuses.map((status) => <span class="status-badge" data-status={status}>{status}</span>)}
              </span>
            </div>
            <h1>从 0 到 1 参与制造企业首次跨境出口</h1>
            <p class="case-subtitle">From contract negotiation to customs declaration</p>
          </div>
          <p class="detail-summary">我并非在一开始就掌握所有出口环节，而是在真实交易推进中，持续拆解问题、寻找工具、咨询合适的专业人士、完成验证，并将经验沉淀为可复用流程。</p>
        </div>
        <dl class="detail-meta">
          <div><dt>档案编号</dt><dd>{project.data.eyebrow}</dd></div>
          <div><dt>英文标签</dt><dd>CROSS-BORDER TRANSACTION × CONTRACT × CUSTOMS</dd></div>
          <div><dt>最近更新</dt><dd>{formatDate(project.data.updatedAt)}</dd></div>
          <div><dt>关键词</dt><dd>{project.data.tags.join(' · ')}</dd></div>
        </dl>
      </header>

      <div class="case-sections shell">
        <section class="case-section" id="background">
          <p class="section-index">01 / PROJECT BACKGROUND</p>
          <h2>项目背景</h2>
          <p>一家制造企业首次尝试直接开展海外业务，内部缺少成熟的外贸执行流程。我参与客户沟通、合同修订、后续履约沟通和出口申报，并与财务、技术人员及外部专业支持方协作，推动交易继续落地。</p>
          <div class="responsibility-grid" aria-label="职责边界">
            <div>
              <h3>我负责</h3>
              <p>英文客户沟通、双语文件修订、合同条款沟通、履约跟进、出口申报、流程梳理</p>
            </div>
            <div>
              <h3>财务负责</h3>
              <p>银行开户、收款及结汇相关工作</p>
            </div>
            <div>
              <h3>技术人员负责</h3>
              <p>产品参数与生产技术事项</p>
            </div>
          </div>
        </section>

        <section class="case-section" id="transaction-flow">
          <p class="section-index">02 / TRANSACTION FLOW</p>
          <h2>交易流程</h2>
          <ol class="case-timeline">
            {processSteps.map(([title, text], index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </li>
            ))}
          </ol>
        </section>

        <section class="case-section" id="core-work">
          <p class="section-index">03 / CORE WORK</p>
          <h2>我的核心工作</h2>
          <div class="case-card-grid">
            {coreWork.map(([title, text], index) => (
              <article>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="case-section" id="key-cases">
          <p class="section-index">04 / ISSUE NOTES</p>
          <h2>关键问题案例</h2>
          <div class="issue-list">
            {keyCases.map((item) => (
              <article>
                <span>{item.label}</span>
                <h3>{item.title}</h3>
                <dl>
                  <div><dt>问题</dt><dd>{item.problem}</dd></div>
                  <div><dt>我的处理</dt><dd>{item.action}</dd></div>
                </dl>
              </article>
            ))}
          </div>
          <article class="confidentiality-case" aria-labelledby="confidentiality-title">
            <header>
              <p class="case-label">CASE B</p>
              <h3 id="confidentiality-title">当客户要求“未标 Confidential 即不保护”</h3>
              <p>从客户异议，到法律判断，再到可执行的合同标准</p>
            </header>
            <ol class="reasoning-flow">
              {confidentialitySteps.map(([title, text], index) => (
                <li><span>{String(index + 1).padStart(2, '0')}</span><div><h4>{title}</h4><p>{text}</p></div></li>
              ))}
            </ol>
            <blockquote>无论是否明确标记为 Confidential，只要根据信息的内容、性质或披露情境，一个合理主体应当理解其属于非公开信息，即纳入保密信息保护范围。</blockquote>
            <p class="case-takeaway">真正需要解决的不是“要不要贴 Confidential 标签”，而是如何在保护敏感信息与确保义务边界可识别之间取得平衡。</p>
          </article>
          <aside class="second-review" aria-labelledby="second-review-title">
            <div class="second-review-heading">
              <p class="case-label">LEGAL TECH SECOND REVIEW</p>
              <h3 id="second-review-title">工具作为第二双眼睛，而不是最终判断者</h3>
              <div class="review-path" aria-label="审查路径"><span>Human Review</span><i>→</i><span>Legal Tech Second Review</span><i>→</i><span>Human Judgment</span></div>
            </div>
            <div>
              <p>完成合同修改后，我使用法律科技产品进行第二轮审查。工具补充提示了返还与销毁、保密范围、禁止绕行、知识产权、违约责任，以及定义与条款间潜在冲突等第一轮未重点关注的风险。</p>
              <p>这些输出不会被直接视为法律结论。例如，没有具体违约金不当然构成重大问题；未约定成果 IP 归属是否有风险，要看交易是否实际产生共同开发成果；风险等级也需放回交易目的和双方权利义务中判断。</p>
              <strong>AI / Legal Tech 用于提高风险覆盖率、发现盲点和验证第一判断；最终判断仍由人基于法律、事实和业务目标完成。</strong>
            </div>
          </aside>
        </section>

        <section class="case-section" id="evidence-materials">
          <p class="section-index">05 / REDACTED MATERIALS</p>
          <h2>证据材料</h2>
          <p class="case-section-lead">以下材料均经过脱敏处理，仅保留足以说明工作过程的文件结构、沟通节点和系统界面。</p>
          <div class="evidence-gallery">
            {evidenceItems.map(([fileName, alt, caption]) => {
              const src = withBase(`images/projects/cross-border-export/${fileName}`);
              return (
                <figure>
                  <a href={src} data-lightbox-src={src} data-lightbox-alt={alt} aria-label={`放大查看：${alt}`}>
                    <img src={src} alt={alt} loading="lazy" />
                  </a>
                  <figcaption>{caption}</figcaption>
                </figure>
              );
            })}
          </div>
          <dialog class="image-lightbox" aria-label="图片放大预览">
            <button type="button" class="lightbox-close" aria-label="关闭图片预览">×</button>
            <img src="" alt="" />
          </dialog>
        </section>

        <section class="case-section" id="working-method">
          <p class="section-index">06 / METHOD</p>
          <h2>我的工作方法</h2>
          <p class="method-subtitle">From first signal to defensible judgment</p>
          <p class="method-intro">从第一判断，到可验证、可执行、可沉淀的结论</p>
          <ol class="method-flow">
            {methodSteps.map(([label, title, text], index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <small>{label}</small><strong>{title}</strong><p>{text}</p>
              </li>
            ))}
          </ol>
          <p class="tool-principle">工具不是替我判断，而是帮助我校准判断和扩大视野。</p>
          <div class="document-lifecycle">
            <p class="case-label">DOCUMENT LIFECYCLE</p>
            <div aria-label="文件生命周期"><span>Initial Draft</span><i>→</i><span>Negotiation &amp; Redlines</span><i>→</i><span>Signed Version</span><i>→</i><span>Reusable Template</span></div>
            <p>同时记录：争议点 · 修改原因 · 关键联系人 · 未完成事项 · Next Actions</p>
            <strong>交接不是 transferring files，而是 transferring context。</strong>
          </div>
          <p class="method-note">我不要求自己一开始掌握所有答案，而是要求自己建立一套能够可靠解决未知问题的方法。</p>
          <p class="ai-boundary-note">对我来说，真正的 ownership 不是所有事情都自己完成，而是知道什么时候继续研究、什么时候使用工具、什么时候咨询专业人员，以及什么时候需要及时收束并形成判断。</p>
        </section>

        <section class="case-section business-extension" id="business-extension">
          <div class="business-extension-copy">
            <p class="section-index">07 / BUSINESS EXTENSION</p>
            <h2>从一次出口，到海外业务基础设施</h2>
            <p class="business-extension-subtitle">From a single export order to a long-term overseas business touchpoint</p>
            <p>完成首个直接海外订单后，我进一步参与企业海外业务基础设施建设，独立搭建并部署英文官网，将制造能力、产品信息、定制能力、海外联系方式、询盘入口和企业基本信息，整理成一个可以直接面向海外客户使用的线上入口。</p>
            <p>重点并不是完成一次网站开发，而是从处理一笔真实海外订单，继续思考一家制造企业如何持续建立直接面向海外客户的业务能力。</p>
            <strong>这个网站不是独立的技术项目，而是跨境业务实践的延伸。</strong>
          </div>
          <article class="business-site-card">
            <p class="site-card-label">ZHONGTE TRANSFORMER</p>
            <div class="site-card-tags"><span>Manufacturing</span><span>Cross-border Business</span><span>Overseas Client Touchpoint</span></div>
            <h3>企业英文官网</h3>
            <p>为制造企业搭建并部署英文独立站，将产品、制造能力和海外询盘入口转化为可直接面向国际客户的业务窗口。</p>
            <a class="button primary" href="https://zhong-te-transformer.com/" target="_blank" rel="noopener noreferrer">访问企业英文官网 →</a>
          </article>
          <p class="business-extension-reflection">理解业务，才能理解法律工作最终要帮助什么事情发生。</p>
        </section>

        <section class="case-section" id="reflection">
          <p class="section-index">08 / REFLECTION</p>
          <h2>项目反思</h2>
          <p>这段经历让我意识到，跨境交易很少只是单一的法律问题。合同、付款、技术、报关、物流和沟通彼此牵连。真正有价值的能力，不只是完成一次任务，而是把陌生问题转化为可执行、可验证、可复用的业务流程。</p>
        </section>

        <section class="case-section related-tool" id="related-legal-ai-project">
          <div>
            <p class="section-index">09 / RELATED PROJECT</p>
            <h2>从真实业务问题到工具原型</h2>
            <p>在处理合同、付款、争议解决和出口流程后，我进一步思考：哪些风险可以前置识别，哪些检查可以标准化，哪些经验可以通过工具复用。由此形成了外贸交易法律风险初筛 Demo。</p>
          </div>
          <a class="button primary" href={withBase('projects/risk-screening/')}>查看外贸交易法律风险初筛工具</a>
        </section>
      </div>
    </article>
    <script>
      const lightbox = document.querySelector<HTMLDialogElement>('.image-lightbox');
      const lightboxImage = lightbox?.querySelector<HTMLImageElement>('img');
      const lightboxClose = lightbox?.querySelector<HTMLButtonElement>('.lightbox-close');

      document.querySelectorAll<HTMLAnchorElement>('[data-lightbox-src]').forEach((trigger) => {
        trigger.addEventListener('click', (event) => {
          if (!lightbox || !lightboxImage) return;
          event.preventDefault();
          lightboxImage.src = trigger.dataset.lightboxSrc || trigger.href;
          lightboxImage.alt = trigger.dataset.lightboxAlt || '';
          lightbox.showModal();
        });
      });

      lightboxClose?.addEventListener('click', () => lightbox?.close());
      lightbox?.addEventListener('click', (event) => {
        if (event.target === lightbox) lightbox.close();
      });
    </script>
