---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import FasuoPracticeGroup from '../../components/FasuoPracticeGroup.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="项目" description="真实业务案例、企业法务、Legal Tech 与法律运营项目档案。">
  <header class="page-hero shell">
    <p class="kicker">PROJECT ARCHIVE</p>
    <h1>项目与实践档案</h1>
    <p>真实业务案例 · 企业法务 · Legal Tech · 法律运营。每个条目说明任务如何被拆解、验证和沉淀，并标注当前形态与专业边界。</p>
  </header>
  <section class="shell page-section">
    <div class="archive-note">
      <span>收录项目 {String(projects.length).padStart(2, '0')}</span>
      <span>真实业务案例 / 已上线 / 本地原型 / 待部署</span>
      <span>最后更新：2026.08.16</span>
    </div>
    <div class="privacy-banner">
      <strong>统一保密说明</strong>
      <p>由于法律服务与外贸场景涉及客户信息、案件材料和业务保密要求，作品集中的演示均基于虚构或脱敏数据，仅用于展示产品逻辑、交互流程和输出结果。</p>
    </div>
    <div class="project-grid project-grid-page">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
    <FasuoPracticeGroup />
  </section>
</BaseLayout>
