---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CapabilityMap from '../components/CapabilityMap.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { withBase, formatDate } from '../lib/site';
import { capabilityMap, capabilityOrder, experienceEvidence } from '../data/capabilities';
import FasuoPracticeGroup from '../components/FasuoPracticeGroup.astro';

const projects = (await getCollection('projects')).filter((item) => item.data.featured).sort((a, b) => a.data.order - b.data.order);
const latestWriting = (await getCollection('writing')).filter((item) => !item.data.draft).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()).slice(0, 3);
---

<BaseLayout>
  <CapabilityMap />

  <section class="career-logic" aria-labelledby="career-logic-heading">
    <div class="shell career-logic-inner">
      <div><p class="section-index">ONE CONNECTED PRACTICE</p><h2 id="career-logic-heading">五种能力，一条完整的交付链路</h2></div>
      <p>以法律训练判断问题，在企业与交易场景中理解约束，通过涉外能力处理跨境协作，再用法律科技方法提升流程清晰度，最终形成合同、SOP、产品原型和可复核成果。</p>
    </div>
  </section>

  <section class="section shell home-projects" id="related-evidence" aria-labelledby="evidence-heading">
    <div class="section-heading">
      <div><p class="section-index">EXPERIENCE & PROJECTS / 相关经历与项目</p><h2 id="evidence-heading"><span id="evidence-heading-text">全部经历与项目</span></h2></div>
      <div class="evidence-heading-actions"><button class="button quiet view-all-button" type="button">查看全部</button><a class="text-link" href={withBase('projects/')}>项目档案 <span>→</span></a></div>
    </div>
    <nav class="category-anchors" aria-label="按岗位视角查看经历与项目">
      {capabilityOrder.map((id) => (
        <button type="button" data-filter={id} data-title={capabilityMap[id].title} data-evidence-ids={capabilityMap[id].evidenceIds.join(' ')}><strong>{capabilityMap[id].shortTitle}</strong><span>{capabilityMap[id].keywords}</span></button>
      ))}
    </nav>
    <p class="current-filter" aria-live="polite">当前查看：<strong id="current-filter-label">全部经历与项目</strong></p>
    <div class="evidence-grid">
      {experienceEvidence.map((item) => (
        <article class="experience-evidence-card evidence-item" id={item.id} data-evidence-id={item.id} data-capability-tags={item.capabilityTags.join(' ')}>
          <p class="evidence-type">{item.type}</p>
          <h3>{item.title}</h3>
          <p class="evidence-summary">{item.summary}</p>
          <div class="evidence-proof"><strong>这项经历证明了什么</strong><p>{item.proof.join('｜')}</p></div>
          <ul class="project-category-tags" aria-label="关联能力">{item.capabilityTags.map((tag) => <li>{capabilityMap[tag].shortTitle}</li>)}</ul>
          {item.id !== 'portfolio-site' && <a class="text-link" href={withBase('background/')}>查看背景详情 <span>→</span></a>}
        </article>
      ))}
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
    <FasuoPracticeGroup />
  </section>

  <section class="privacy-banner shell"><strong>保密与真实性说明</strong><p>作品集保留现有真实项目与公开链接；涉及案件、客户和交易的信息均使用虚构、脱敏材料或占位内容，不以工具输出替代专业判断。</p></section>

  <section class="section writing-preview">
    <div class="shell">
      <div class="section-heading light-heading"><div><p class="section-index">WRITING / 近期写作</p><h2>记录法律、业务与技术交界处的观察</h2></div><a class="text-link" href={withBase('writing/')}>查看全部文章 <span>→</span></a></div>
      <div class="writing-list">
        {latestWriting.map((article, index) => (
          <a class="writing-row" href={article.data.externalUrl || withBase(`writing/${article.id}/`)} target={article.data.externalUrl ? '_blank' : undefined} rel={article.data.externalUrl ? 'noopener noreferrer' : undefined}>
            <span class="row-number">{String(index + 1).padStart(2, '0')}</span><span class="row-main"><strong>{article.data.title}</strong><small>{article.data.description}</small></span><span class="row-meta">{article.data.statuses.join(' / ')}<br />{formatDate(article.data.publishedAt)}</span><span class="row-arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="closing-cta shell" id="contact"><p class="kicker">OPEN TO CONVERSATION</p><h2>让法律分析进入真实业务，<br />并形成清晰、可执行的成果</h2><a class="button primary" href={withBase('contact/')}>联系我</a></section>

  <script>
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const evidenceItems = Array.from(document.querySelectorAll<HTMLElement>('.evidence-item'));
    const heading = document.querySelector<HTMLElement>('#evidence-heading-text');
    const currentLabel = document.querySelector<HTMLElement>('#current-filter-label');
    const evidenceSection = document.querySelector<HTMLElement>('#related-evidence');
    const fasuoGroup = document.querySelector<HTMLElement>('#fasuo-ai-practice');
    const nodes = Array.from(document.querySelectorAll<HTMLButtonElement>('.capability-node'));

    const showCapability = (id: string, title: string, evidenceIds: string[], scroll = true) => {
      heading && (heading.textContent = `${title}：相关经历`);
      currentLabel && (currentLabel.textContent = title);
      filters.forEach((item) => item.classList.toggle('is-active', item.dataset.filter === id));
      nodes.forEach((item) => { const selected = item.dataset.capability === id; item.classList.toggle('is-selected', selected); item.setAttribute('aria-pressed', String(selected)); });
      evidenceItems.forEach((item) => {
        const index = evidenceIds.indexOf(item.dataset.evidenceId || '');
        item.hidden = index < 0;
        item.style.order = index < 0 ? '' : String(index);
      });
      if (fasuoGroup) fasuoGroup.hidden = !['legal-tech', 'legal-operations'].includes(id);
      if (scroll) (id === 'legal-tech' ? document.querySelector('#experience-fasuo') : evidenceSection)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    filters.forEach((filter) => filter.addEventListener('click', () => showCapability(filter.dataset.filter || '', filter.dataset.title || '', (filter.dataset.evidenceIds || '').split(' ').filter(Boolean))));
    document.addEventListener('capability-select', ((event: CustomEvent) => showCapability(event.detail.id, event.detail.title, event.detail.evidenceIds)) as EventListener);
    document.querySelector('.view-all-button')?.addEventListener('click', () => {
      heading && (heading.textContent = '全部经历与项目'); currentLabel && (currentLabel.textContent = '全部经历与项目');
      filters.forEach((item) => item.classList.remove('is-active'));
      nodes.forEach((item) => { item.classList.remove('is-selected'); item.setAttribute('aria-pressed', 'false'); });
      evidenceItems.forEach((item) => { item.hidden = false; item.style.order = ''; });
      if (fasuoGroup) fasuoGroup.hidden = false;
    });
  </script>
</BaseLayout>
