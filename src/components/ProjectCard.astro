---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/site';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const poster = project.data.demoMedia.poster || project.data.cover;
const previewImage = project.data.demoMedia.previewAnimation || poster;
const isCaseStudy = project.id === 'cross-border-export';
const isWorkflow = project.id === 'employment-legal-workflow';
const isEarlyExploration = project.id === 'risk-screening';
const categoryLabels = {
  'legal-support': '法律研究与律师支持',
  'in-house-legal': '企业法务与合同管理',
  'legal-tech': '法律科技',
  'cross-border': '涉外业务',
  'legal-operations': '法律运营'
};
const projectProof: Record<string, string[]> = {
  'cross-border-export': ['真实企业法务场景', '商业合同', '跨境交易', '风险控制'],
  'employment-legal-workflow': ['问题识别', '程序与证据', '跨职能协同', '流程化思维'],
  'evidence-organizer': ['证据整理', '律师工作流', '工具原型', '教程交付'],
  'risk-screening': ['陌生问题拆解', 'Question Checklist', '信息整理', '专业升级'],
  'time-calculator': ['法律规则', '争议支持', '规则引擎', '报告交付']
};
---

<article class:list={['project-card', 'demo-project-card', 'evidence-item', { 'case-study-card': isCaseStudy, 'workflow-card': isWorkflow, 'early-exploration-card': isEarlyExploration }]} data-evidence-id={project.id} data-capability-tags={project.data.categories.join(' ')}>
  <a
    class:list={['demo-preview', { 'case-preview': isCaseStudy }]}
    href={withBase((isCaseStudy || isWorkflow) ? `projects/${project.id}/` : `projects/${project.id}/#demo-walkthrough`)}
    aria-label={isWorkflow ? `查看${project.data.title}` : isCaseStudy ? `查看${project.data.title}案例` : `观看${project.data.title}演示`}
  >
    {!isCaseStudy && !isWorkflow && (
      <video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={withBase(poster)}
        aria-label={`${project.data.title} GIF 预览`}
      >
        {project.data.demoMedia.previewVideo && <source src={withBase(project.data.demoMedia.previewVideo)} type="video/mp4" />}
      </video>
    )}
    {isWorkflow ? (
      <div class="workflow-preview-content"><span>ISSUE</span><i>→</i><span>FACTS</span><i>→</i><span>RULES</span><i>→</i><span>RECOMMENDATION</span></div>
    ) : (!project.data.demoMedia.previewVideo || isCaseStudy) && <img src={withBase(isCaseStudy ? poster : previewImage)} alt={project.data.coverAlt || ''} loading="lazy" />}
    <span class="project-number">{project.data.eyebrow}</span>
    <span class="preview-label">{isWorkflow ? 'WORKFLOW / 方法框架' : isCaseStudy ? 'CASE STUDY / 真实业务案例' : isEarlyExploration ? 'EARLY EXPLORATION / 早期探索' : 'GIF Preview / 演示预览'}</span>
  </a>
  <div class="card-body">
    <ul class="project-category-tags" aria-label="项目能力分类">
      {project.data.categories.map((category) => <li>{categoryLabels[category]}</li>)}
    </ul>
    <div class="meta-row">
      {project.data.year && <span>{project.data.year}</span>}
      <span class="status-group">
        {project.data.statuses.map((status) => <span class="status-badge" data-status={status}>{status}</span>)}
      </span>
    </div>
    <h3><a href={withBase(`projects/${project.id}/`)}>{project.data.title}</a></h3>
    <p class="project-one-line">{project.data.oneLine}</p>
    <div class="evidence-proof"><strong>这项经历证明了什么</strong><p>{projectProof[project.id].join('｜')}</p></div>
    <p class="project-privacy-line">
      {isWorkflow ? '方法框架；明确标注当前经验边界，并连接已有实践。' : isCaseStudy ? '真实业务案例；公开页面仅展示脱敏流程和占位材料。' : '演示均使用虚构或脱敏数据，不展示真实业务材料。'}
    </p>
    <div class="project-card-actions">
      {isCaseStudy || isWorkflow ? (
        <a class="button primary" href={withBase(`projects/${project.id}/`)}>{isWorkflow ? '查看工作框架' : '查看案例'}</a>
      ) : (
        <>
          <a class="button primary" href={withBase(`projects/${project.id}/#demo-walkthrough`)}>观看演示</a>
          <a class="button quiet" href={withBase(`projects/${project.id}/#sample-output`)}>查看样例输出</a>
        </>
      )}
    </div>
  </div>
</article>
